# =====================================================================
# EchoLive - Environment Configuration
# =====================================================================

# Server Port
PORT=3000

# Node Environment
NODE_ENV=production

# ---------------------------------------------------------------------
# Google Gemini API Key (Recommended for 100% Reliable Cloud Translation)
# ---------------------------------------------------------------------
# Why this is needed:
# Cloud providers (Render, AWS, GCP, etc.) frequently block or rate-limit
# unauthenticated free scraping translation endpoints.
# Adding a free Gemini API key guarantees instantaneous, literary-grade
# simultaneous translation into Galician (gl), Spanish (es), and other languages.
#
# Get your FREE API key in 1 click at:
# 👉 https://aistudio.google.com/apikey
#
# Leave empty to use resilient multi-tier free fallback (MyMemory + Google).
GEMINI_API_KEY=

# Gemini Model Selection:
# - gemini-2.0-flash (Recommended: ultra-low latency & high precision)
# - gemini-1.5-flash
# - gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash
